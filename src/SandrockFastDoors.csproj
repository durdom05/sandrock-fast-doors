<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Build:  dotnet build -c Release -p:GameDir="C:\Program Files (x86)\Steam\steamapps\common\My Time at Sandrock"
    GameDir must contain Sandrock_Data\Managed (game DLLs) and BepInEx\core (BepInEx 5.4.23.x installed).
    Game DLLs are NOT part of this repository (they are copyrighted by Pathea).
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>SandrockFastDoors</AssemblyName>
    <RootNamespace>SandrockFastDoors</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <Version>1.3.0</Version>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\My Time at Sandrock</GameDir>
    <ManagedDir>$(GameDir)\Sandrock_Data\Managed</ManagedDir>
    <BepInExCore>$(GameDir)\BepInEx\core</BepInExCore>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(BepInExCore)\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExCore)\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Pathea.Framework"><HintPath>$(ManagedDir)\Pathea.Framework.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Pathea.AssetMgr"><HintPath>$(ManagedDir)\Pathea.AssetMgr.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Pathea.WhiteCat"><HintPath>$(ManagedDir)\Pathea.WhiteCat.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BaseUtilities"><HintPath>$(ManagedDir)\BaseUtilities.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ManagedDir)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(ManagedDir)\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(ManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.RenderPipelines.Universal.Runtime"><HintPath>$(ManagedDir)\Unity.RenderPipelines.Universal.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.RenderPipelines.Core.Runtime"><HintPath>$(ManagedDir)\Unity.RenderPipelines.Core.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(ManagedDir)\Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Cinemachine"><HintPath>$(ManagedDir)\Cinemachine.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
